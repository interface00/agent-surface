{
  "name": "@orangestudio/agent-surface",
  "version": "0.1.0",
  "description": "Serve Markdown to AI readers and HTML to ranking crawlers without cloaking, then measure whether any of them actually came.",
  "type": "module",
  "license": "MIT",
  "author": "Orange Studio (SHOEDOG INC) <hello@orangeai.co.kr> (https://orangeai.co.kr)",
  "homepage": "https://github.com/interface00/agent-surface#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interface00/agent-surface.git"
  },
  "bugs": {
    "url": "https://github.com/interface00/agent-surface/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
