{
  "name": "agent-surface",
  "version": "0.1.0",
  "description": "Serve Markdown to AI readers and HTML to ranking crawlers without cloaking, then measure whether any of them actually came.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "exports": {
    ".": "./src/agents.mjs",
    "./negotiate": "./src/negotiate.mjs"
  },
  "files": ["src", "scripts", "examples", "README.md", "AGENTS.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "index:status": "node scripts/index-status.mjs",
    "ai:crawlers": "node scripts/ai-crawlers.mjs"
  },
  "keywords": [
    "llm", "ai-crawler", "gptbot", "claudebot", "perplexity",
    "content-negotiation", "markdown", "geo", "aeo",
    "indexnow", "search-console", "cloudflare-pages", "seo"
  ],
  "dependencies": {}
}
